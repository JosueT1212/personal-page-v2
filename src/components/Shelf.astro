---
import { getCollection } from 'astro:content';
import BookCover from './BookCover.astro';
interface Props { variant: 'home' | 'page'; }
const { variant } = Astro.props;
const books = (await getCollection('books')).map((b) => b.data);
const CATS = [['mathematics', 'Mathematics'], ['chess', 'Chess'], ['beyond', 'Beyond']] as const;
const byCat = CATS.map(([k, label]) => ({ label, items: books.filter((b) => b.category === k) }));
const home = byCat.flatMap((g) => g.items);
const page = byCat.filter((g) => g.items.length);
---
{variant === 'home' ? (
  <section class="shelf home">
    <div class="items">
      {home.map((b) => (
        <div class="book">
          <BookCover motif={b.motif} title={b.title} cover={b.cover} size="thumb" />
          <div class="meta">
            {b.title}<br />
            <span class="g">{b.author}{b.status === 'reading' && <> · reading</>}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
) : page.map((g) => (
  <section class="leader-list">
    <h2 class="leader-head"><span>{g.label}</span><span>{`${g.items.length} ${g.items.length === 1 ? 'book' : 'books'}`}</span></h2>
    <ol>
      {g.items.map((b, i) => (
        <li class="leader-item book-entry">
          <BookCover motif={b.motif} title={b.title} cover={b.cover} size="thumb" />
          <div>
            <div class="leader-row"><span class="leader-title">{b.title}</span><span class="leader-dots"></span><span class="leader-num">{i + 1}</span></div>
            <p class="leader-meta">{b.author}{b.status === 'reading' && <> · <span class="note">reading</span></>}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
))}
<script>import '../scripts/covers-client.ts';</script>

<style>
  .items { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 55px; row-gap: 21px; }
  .home .book { display: grid; grid-template-columns: 42px 1fr; column-gap: 16px; align-items: center; }
  .meta { font-size: 17px; }
  .meta .g { font-style: italic; }
  .book-entry { display: grid; grid-template-columns: 42px 1fr; column-gap: 21px; align-items: center; }
  section.leader-list + section.leader-list { margin-top: 89px; }
  h2.leader-head { font-weight: 450; }
  @media (max-width: 899px) { .items { grid-template-columns: 1fr; } }
</style>

---
import { getCollection } from 'astro:content';
const { current } = Astro.props;
const hasGallery = (await getCollection('gallery')).length > 0;
const links = [
  ['writing', 'Writing'],
  ['open-questions', 'Open questions'],
  ['bookshelf', 'Bookshelf'],
  ['gallery', 'Gallery'],
].filter(([slug]) => slug !== 'gallery' || hasGallery);
---
<header>
  <nav>
    {links.map(([slug, name]) => (
      <a href={`/${slug}`} style={slug === current ? 'color:var(--label)' : undefined}>{name}</a>
    ))}
  </nav>
</header>
<style>
  header { display: flex; justify-content: flex-end; text-align: right; margin-bottom: 55px; }
  nav { display: flex; flex-direction: column; }
</style>

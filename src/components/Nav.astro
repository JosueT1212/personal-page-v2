---
import { getCollection } from 'astro:content';
interface Props { current?: string; variant?: 'home' | 'leader'; }
const { current, variant = 'leader' } = Astro.props;
const hasGallery = (await getCollection('gallery')).length > 0;
const NUMERALS = ['I', 'II', 'III', 'IV'];
const links = [
  ['writing', 'Writing'],
  ['open-questions', 'Open questions'],
  ['bookshelf', 'Bookshelf'],
  ['gallery', 'Gallery'],
].filter(([slug]) => slug !== 'gallery' || hasGallery);
const home = variant === 'home';
---
<header>
  {home ? <span></span> : <a class="back" href="/">← Josue Tapia</a>}
  <nav class={home ? 'plain' : undefined}>
    {links.map(([slug, name], i) => home ? (
      <a href={`/${slug}`} aria-current={slug === current ? 'page' : undefined}>{name}</a>
    ) : (
      <a class="leader-row" href={`/${slug}`} aria-current={slug === current ? 'page' : undefined}>
        <span class="leader-title">{name}</span><span class="leader-dots"></span><span class="leader-num">{NUMERALS[i]}</span>
      </a>
    ))}
  </nav>
</header>
<style>
  nav.plain { width: auto; align-items: flex-end; gap: 8px; }
  nav.plain a { color: var(--ink); font-weight: 400; font-size: 17px; }
  nav.plain a:hover { color: var(--label); }
  header { display: flex; justify-content: space-between; align-items: flex-start; gap: 21px; margin-bottom: 55px; }
  .back { color: var(--gray); font-style: italic; }
  .back:hover { color: var(--ink); }
  nav { display: flex; flex-direction: column; gap: 8px; width: 330px; max-width: 60vw; }
  nav .leader-title { font-size: 15px; }
  nav .leader-num { font-style: normal; font-size: 15px; letter-spacing: 0.06em; }
  nav [aria-current] .leader-title { color: var(--label); }
  nav a:hover .leader-title { color: var(--label); }
  @media (max-width: 899px) { nav { width: 220px; } nav .leader-title, nav .leader-num { font-size: 13px; } }
</style>

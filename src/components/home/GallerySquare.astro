---
import { getCollection } from 'astro:content';
const empty = (await getCollection('gallery')).length === 0;
const Tag = empty ? 'div' : 'a';
---
<Tag class="cell gal" href={empty ? undefined : '/gallery'}>
  <div class="mini pv" aria-hidden="true"><i style="grid-area:a"></i><i style="grid-area:b"></i><i style="grid-area:c"></i><i style="grid-area:d"></i></div>
  <span class="label">§4 Gallery</span>
  <span class="g">{empty ? 'Soon' : 'Open →'}</span>
  <span class="n">2</span>
</Tag>

<style>
  .gal { padding: 13px; display: flex; flex-direction: column; justify-content: space-between; }
  .label { margin: 0; }
  .mini { display: grid; grid-template-columns: 5fr 3fr; grid-template-rows: 3fr 1fr 1fr; grid-template-areas: "a b" "a c" "a d"; gap: 2px; width: 70%; aspect-ratio: 8 / 5; margin-top: 4px; }
  .mini i { background: var(--ink); opacity: 0.28; border-radius: 1px; }
  .mini i:first-child { opacity: 0.5; }
  a.gal:hover .mini i, a.gal:focus-visible .mini i { opacity: 0.7; }
</style>

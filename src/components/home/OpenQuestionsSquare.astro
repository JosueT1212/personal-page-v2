---
import { primeGraph } from '../../lib/prime-graph';
const { nodes, edges } = primeGraph(30);
const at = new Map(nodes.map((n) => [n.k, n]));
---
<a class="cell oq" href="/open-questions">
  <p class="label">§3 Open questions</p>
  <svg class="pv" viewBox="0 0 220 190" aria-hidden="true">
    {edges.map(([a, b]) => <line x1={at.get(a)!.x} y1={at.get(a)!.y} x2={at.get(b)!.x} y2={at.get(b)!.y} />)}
    {nodes.map((n) => n.prime
      ? <><circle class="p" cx={n.x} cy={n.y} r="4" /><text x={n.x} y={n.y + 15}>{n.k}</text></>
      : <circle class="c" cx={n.x} cy={n.y} r="2.3" />)}
  </svg>
  <span class="open g">Open →</span>
  <span class="n">3</span>
</a>

<style>
  .oq { padding: 13px 13px 6px; }
  .label { margin: 0; }
  svg { width: 100%; height: calc(100% - 20px); display: block; }
  line { stroke: var(--ink); stroke-opacity: 0.35; stroke-width: 0.8; }
  .p { fill: var(--label); }
  .c { fill: var(--bg); stroke: var(--ink); stroke-width: 0.9; }
  text { fill: var(--gray); font-size: 9px; font-weight: 600; text-anchor: middle; font-family: var(--font-serif); }
</style>

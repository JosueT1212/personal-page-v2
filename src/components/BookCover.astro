---
interface Props { motif: { name: string; seed?: number }; title: string; size: 'thumb' | 'large'; cover?: string; }
const { motif, title, size, cover } = Astro.props;
const urls = import.meta.glob<string>('/src/assets/covers/*', { eager: true, query: '?url', import: 'default' });
const url = cover ? urls[`/src/assets/covers/${cover}`] : undefined;
if (cover && !url) throw new Error(`Missing cover file src/assets/covers/${cover} for "${title}"`);
---
<div class={`cover ${size}`} role="img" aria-label={`Cover of ${title}`}>
  <canvas data-motif={JSON.stringify(motif)} data-cover={url} data-title={title}></canvas>
</div>

<style>
  .cover { aspect-ratio: 8 / 13; position: relative; overflow: hidden; }
  .thumb { width: 42px; }
  .large { width: 144px; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
